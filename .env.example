SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Local: http://127.0.0.1:5000/callback. Server: https://<TS_HOSTNAME>.<tailnet>.ts.net/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback
# Any long random string. Keep it fixed so restarts don't log you out.
FLASK_SECRET_KEY=change-me

# Server (Docker) only
# Tailscale auth key from https://login.tailscale.com/admin/settings/keys. Only needed for the first start.
TS_AUTHKEY=
# The machine name in your tailnet, i.e. the first part of the https://….ts.net address.
TS_HOSTNAME=playlist
# Leave HOST/PORT unset on the server: deploy/serve.json forwards to 127.0.0.1:5000.
# HOST=127.0.0.1
# PORT=5000
